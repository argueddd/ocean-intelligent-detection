# 深海智探统一配置。复制为 backend/.env 后填写；backend/.env 不会进入 Git。

# Harness 服务
HOST=127.0.0.1
PORT=3089
DSH_PROFILE=harness
DSH_HOME_DIR=.runtime/web-harness-home
DSH_CHILD_HTTP_PORT=3090

# Docker Web 入口使用；本机 ./start.sh --harness 使用 5173。
WEB_PORT=8080

# 文本模型（必填）
# Base URL 使用模型服务的 OpenAI 兼容 /v1 地址。
LLM_PROVIDER=aliyun
LLM_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_API_KEY=replace-with-your-model-api-key
LLM_MAX_TOKENS=8192
LLM_THINKING=false
# 可选 SDK 档位覆盖：off 或 low；留空沿用 LLM_THINKING。
LLM_REASONING_EFFORT=

# 视觉模型（图片理解需要；可与文本模型使用同一服务和密钥）
VLM_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-omni-flash
VLM_API_KEY=replace-with-your-vision-api-key
VLM_REASONING_EFFORT=none
VLM_MAX_IMAGE_BYTES=5242880

# 旧知识库门户专用；只运行 ./start.sh --harness 时保持为空即可。
LIGHTRAG_BASE_URL=
LIGHTRAG_API_KEY=
MINERU_BASE_URL=
MINERU_API_KEY=
KB_RAG_STORAGE=
KB_LIGHTRAG_INPUTS_DIR=

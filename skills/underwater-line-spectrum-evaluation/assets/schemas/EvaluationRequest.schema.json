{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0:EvaluationRequest",
  "title": "EvaluationRequest contract 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "const": "EvaluationRequest"
    },
    "document_status": {
      "enum": [
        "draft",
        "specified"
      ]
    },
    "payload": {
      "type": "object"
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/issue"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "document_status",
    "payload",
    "unresolved_items"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "document_status": {
            "const": "draft"
          }
        },
        "required": [
          "document_status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "request_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "question": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "targets": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/target"
                    },
                    "minItems": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "truth_bindings": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/truth_binding"
                    },
                    "minItems": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "metric_requests": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/metric_request"
                    },
                    "minItems": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "matching_rules": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/matching_rule"
                    },
                    "minItems": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output_plan": {
                "anyOf": [
                  {
                    "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/output_plan"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confirmation": {
                "anyOf": [
                  {
                    "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/confirmation"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accepted_limitations": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "request_id",
              "question",
              "targets",
              "truth_bindings",
              "metric_requests",
              "matching_rules",
              "output_plan",
              "confirmation",
              "accepted_limitations"
            ],
            "additionalProperties": false
          },
          "unresolved_items": {
            "type": "array",
            "items": {
              "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/issue"
            },
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "payload": {
            "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/EvaluationRequest"
          },
          "unresolved_items": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

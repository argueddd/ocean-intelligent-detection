{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0:TruthCoverage",
  "title": "TruthCoverage contract 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "const": "TruthCoverage"
    },
    "document_status": {
      "enum": [
        "draft",
        "specified"
      ]
    },
    "payload": {
      "type": "object"
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/issue"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "document_status",
    "payload",
    "unresolved_items"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "document_status": {
            "const": "draft"
          }
        },
        "required": [
          "document_status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "coverage_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target": {
                "anyOf": [
                  {
                    "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/target"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "availability": {
                "anyOf": [
                  {
                    "enum": [
                      "available",
                      "none",
                      "unknown"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence_origin": {
                "anyOf": [
                  {
                    "enum": [
                      "measurement_annotation",
                      "simulation",
                      "injection",
                      "model",
                      "expected_reference",
                      "none",
                      "unknown"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "provenance_refs": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/reference"
                    },
                    "minItems": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label_semantics": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "regions": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/region"
                    },
                    "minItems": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outside_regions_policy": {
                "anyOf": [
                  {
                    "const": "unknown"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "independence": {
                "anyOf": [
                  {
                    "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/independence"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "limitations": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "coverage_id",
              "target",
              "availability",
              "evidence_origin",
              "provenance_refs",
              "label_semantics",
              "regions",
              "outside_regions_policy",
              "independence",
              "limitations"
            ],
            "additionalProperties": false
          },
          "unresolved_items": {
            "type": "array",
            "items": {
              "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/issue"
            },
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "payload": {
            "$ref": "urn:underwater-line-spectrum-evaluation:contracts:0.1.0#/$defs/TruthCoverage"
          },
          "unresolved_items": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwater-beamforming-evaluation:contracts:1.0.0:EvaluationRequest",
  "title": "Beamforming EvaluationRequest 1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "EvaluationRequest"},
    "document_status": {"enum": ["draft", "specified"]},
    "payload": {"type": "object"},
    "unresolved_items": {
      "type": "array",
      "items": {"$ref": "urn:underwater-beamforming-evaluation:contracts:1.0.0#/$defs/issue"}
    }
  },
  "required": ["schema_version", "record_type", "document_status", "payload", "unresolved_items"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"document_status": {"const": "specified"}}, "required": ["document_status"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "request_id": {"$ref": "urn:underwater-beamforming-evaluation:contracts:1.0.0#/$defs/text"},
              "mode": {"enum": ["descriptive", "paper", "engineering", "dual"]},
              "question": {"$ref": "urn:underwater-beamforming-evaluation:contracts:1.0.0#/$defs/text"},
              "jobs": {
                "type": "array",
                "items": {"$ref": "urn:underwater-beamforming-evaluation:contracts:1.0.0#/$defs/job"},
                "minItems": 1
              },
              "output_plan": {"$ref": "urn:underwater-beamforming-evaluation:contracts:1.0.0#/$defs/output_plan"},
              "confirmation": {"$ref": "urn:underwater-beamforming-evaluation:contracts:1.0.0#/$defs/confirmation"},
              "accepted_limitations": {
                "type": "array",
                "items": {"$ref": "urn:underwater-beamforming-evaluation:contracts:1.0.0#/$defs/text"}
              }
            },
            "required": ["request_id", "mode", "question", "jobs", "output_plan", "confirmation", "accepted_limitations"],
            "additionalProperties": false
          },
          "unresolved_items": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "request_id": {}, "mode": {}, "question": {}, "jobs": {},
              "output_plan": {}, "confirmation": {}, "accepted_limitations": {}
            },
            "required": ["request_id", "mode", "question", "jobs", "output_plan", "confirmation", "accepted_limitations"],
            "additionalProperties": false
          },
          "unresolved_items": {"minItems": 1}
        }
      }
    }
  ]
}

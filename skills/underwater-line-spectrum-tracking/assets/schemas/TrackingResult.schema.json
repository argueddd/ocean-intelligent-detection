{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:underwater-line-spectrum-tracking:result:1.0.0",
  "title": "TrackingResult 1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "TrackingResult"},
    "status": {"const": "completed"},
    "tracking_run_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "resolved_algorithm": {"type": "object"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
    "candidate_track_associations": {"type": "array", "items": {"$ref": "#/$defs/association"}},
    "row_ledger": {"type": "array", "items": {"$ref": "#/$defs/row"}, "minItems": 1},
    "semantic_boundary": {"$ref": "#/$defs/boundary"},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "validation": {"type": "object"}
  },
  "required": ["schema_version", "record_type", "status", "tracking_run_id", "source",
    "resolved_algorithm", "coverage", "tracks", "candidate_track_associations", "row_ledger",
    "semantic_boundary", "limitations", "validation"],
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "properties": {
        "handoff_path": {"type": "string", "minLength": 1},
        "handoff_sha256": {"$ref": "#/$defs/hash"},
        "detection_run_id": {"type": "string", "minLength": 1},
        "detection_task_id": {"type": "string", "minLength": 1},
        "candidate_table_sha256": {"$ref": "#/$defs/hash"},
        "ledger_sha256": {"$ref": "#/$defs/hash"},
        "time_reference": {"type": "string", "minLength": 1},
        "input_ref": {"type": "object"},
        "detector": {"type": "object"},
        "beam_source": {"type": "object"},
        "analysis_grid": {"type": "object"},
        "power_measurement_definition": {
          "anyOf": [{"type": "object"}, {"type": "null"}]
        }
      },
      "required": ["handoff_path", "handoff_sha256", "detection_run_id", "detection_task_id",
        "candidate_table_sha256", "ledger_sha256", "time_reference", "input_ref", "detector",
        "beam_source", "analysis_grid", "power_measurement_definition"],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "detection_row_count": {"type": "integer", "minimum": 1},
        "tested_row_count": {"type": "integer", "minimum": 0},
        "skipped_row_count": {"type": "integer", "minimum": 0},
        "zero_candidate_row_count": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "associated_candidate_count": {"type": "integer", "minimum": 0},
        "time_range_seconds": {
          "type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2
        }
      },
      "required": ["detection_row_count", "tested_row_count", "skipped_row_count",
        "zero_candidate_row_count", "candidate_count", "associated_candidate_count", "time_range_seconds"],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "point_index": {"type": "integer", "minimum": 0},
        "candidate_id": {"type": "string", "minLength": 1},
        "row": {"type": "integer", "minimum": 0},
        "time_seconds": {"type": "number"},
        "frequency_hz": {"type": "number", "minimum": 0},
        "power": {"anyOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]},
        "association_kind": {"enum": ["new_track", "matched"]},
        "predicted_frequency_hz": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "frequency_residual_hz": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "power_change_db": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "association_cost": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}
      },
      "required": ["point_index", "candidate_id", "row", "time_seconds", "frequency_hz", "power",
        "association_kind", "predicted_frequency_hz", "frequency_residual_hz", "power_change_db", "association_cost"],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "track_id": {"type": "string", "pattern": "^track_[0-9]{6}$"},
        "confirmation_status": {"enum": ["tentative", "confirmed"]},
        "termination_reason": {"enum": ["gap_exceeded", "end_of_input"]},
        "start_row": {"type": "integer", "minimum": 0},
        "end_row": {"type": "integer", "minimum": 0},
        "start_time_seconds": {"type": "number"},
        "end_time_seconds": {"type": "number"},
        "detection_count": {"type": "integer", "minimum": 1},
        "maximum_consecutive_missed_rows": {"type": "integer", "minimum": 0},
        "frequency_summary": {
          "type": "object",
          "properties": {
            "minimum_hz": {"type": "number", "minimum": 0},
            "maximum_hz": {"type": "number", "minimum": 0},
            "mean_hz": {"type": "number", "minimum": 0},
            "ols_slope_hz_per_s": {"anyOf": [{"type": "number"}, {"type": "null"}]}
          },
          "required": ["minimum_hz", "maximum_hz", "mean_hz", "ols_slope_hz_per_s"],
          "additionalProperties": false
        },
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 1},
        "quality_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "required": ["track_id", "confirmation_status", "termination_reason", "start_row", "end_row",
        "start_time_seconds", "end_time_seconds", "detection_count", "maximum_consecutive_missed_rows",
        "frequency_summary", "points", "quality_flags"],
      "additionalProperties": false
    },
    "association": {
      "type": "object",
      "properties": {
        "detection_run_id": {"type": "string", "minLength": 1},
        "detection_task_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "tracking_run_id": {"type": "string", "minLength": 1},
        "track_id": {"type": "string", "pattern": "^track_[0-9]{6}$"},
        "row": {"type": "integer", "minimum": 0},
        "association_kind": {"enum": ["new_track", "matched"]}
      },
      "required": ["detection_run_id", "detection_task_id", "candidate_id", "tracking_run_id",
        "track_id", "row", "association_kind"],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "time_seconds": {"type": "number"},
        "source_status": {"enum": ["tested", "skipped"]},
        "candidate_count": {"type": "integer", "minimum": 0},
        "matched_count": {"type": "integer", "minimum": 0},
        "new_track_count": {"type": "integer", "minimum": 0},
        "unmatched_active_track_count": {"type": "integer", "minimum": 0},
        "terminated_track_ids": {"type": "array", "items": {"type": "string", "pattern": "^track_[0-9]{6}$"}, "uniqueItems": true},
        "active_track_count_after_row": {"type": "integer", "minimum": 0}
      },
      "required": ["row", "time_seconds", "source_status", "candidate_count", "matched_count",
        "new_track_count", "unmatched_active_track_count", "terminated_track_ids", "active_track_count_after_row"],
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "detection_recomputed": {"const": false},
        "tracking_performed": {"const": true},
        "harmonic_grouping_performed": {"const": false},
        "source_association_performed": {"const": false},
        "target_identification_performed": {"const": false},
        "evaluation_performed": {"const": false}
      },
      "required": ["detection_recomputed", "tracking_performed", "harmonic_grouping_performed",
        "source_association_performed", "target_identification_performed", "evaluation_performed"],
      "additionalProperties": false
    }
  }
}

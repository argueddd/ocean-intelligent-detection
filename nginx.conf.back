        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
    }


    location /ai-diagnosis/app/ {
        proxy_pass http://04d71585bf2c:5050/;
        proxy_set_header Host localhost;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
    }

    # 审核产品前端应用
    location /ai-frontend/app/ {
        proxy_pass http://ai-frontend-review:80/;
        proxy_set_header Host localhost;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
    }

    # 秦岭AI宣传页
    location /product-view/ {
        rewrite ^/product-view/?(.*)$ /$1 break;
        proxy_pass http://qinling-ai:8082;
        proxy_set_header Host localhost;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;

        # WebSocket 支持（很多 AI 前端需要）
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }




